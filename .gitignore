# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyc
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/

# ─── AWS Credentials — NEVER commit ──────────────────────────────────────────
.env
.env.*
!.env.example          # .env.example (no real values) IS allowed
credentials
.aws/credentials
*.pem
*.key
*.p12
secrets.json
secrets.yaml
secrets.yml

# ─── Terraform ────────────────────────────────────────────────────────────────
# State files contain resource IDs and may contain sensitive output values
*.tfstate
*.tfstate.backup
.terraform/
.terraform.lock.hcl
terraform.tfvars          # May contain real values — use .example file instead
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ─── Model Artifacts ─────────────────────────────────────────────────────────
# Large binary files — track with Git LFS or S3 in production
*.joblib
*.pkl
*.pickle
*.h5
*.pt
*.pth

# ─── Generated Data ───────────────────────────────────────────────────────────
# Synthetic data files — regenerated by running the pipeline
sample_data/*.parquet
sample_data/*.csv
sample_data/*.json

# ─── Generated Reports ────────────────────────────────────────────────────────
reports/*.json
reports/*.txt
reports/*.csv

# ─── IDE and OS ───────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
